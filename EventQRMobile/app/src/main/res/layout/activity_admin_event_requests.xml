<?xml version="1.0" encoding="utf-8"?>
<!--
    ADMIN EVENT REQUESTS (§6.5 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen A.

        Compact pass head (title Event requests, count on the title row)
        Chip row: Pending / Approved / Rejected - 36dp, radius 4, no check icon, no All chip
                 (Pending is the default filter, so a fourth chip would restate it)
        Rows: flat 88dp page rows (requester tile, event name, requester + submitted, one badge)

    Deleted: the EventQrTabHeader, `bg_organizer_events_screen`, the hand-styled 32dp chips with
    per-state drawables, the card-per-request tinted badge family and the elevation-bearing
    error box.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ═════════ Chip row: the filter is the fill, never a check icon ═════════ -->
    <!-- §5.6: the filter row wraps on a Flow, it never scrolls. Three chips per line; 36dp fill
         inside a 48dp touch target, wrap height so a grown label is not clipped. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/space_8">

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/chipFlow"
            style="@style/Widget.EventQR.Ui.ChipFlow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="chipPending,chipApproved,chipRejected"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/chipPending"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_admin_filter_pending" />

        <TextView
            android:id="@+id/chipApproved"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_admin_filter_approved" />

        <TextView
            android:id="@+id/chipRejected"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_admin_filter_rejected" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- §6.8: the pull-to-refresh state is this in-flow strip, not the swipe layout's raised disc
         (suppressed in EventQrSwipeRefreshLayout). It takes its own 2dp above the list, so it never
         covers a row. Same gutter as the chips, so it never opens a third left edge, over a hairline
         track so the empty band still reads as a track, and it grows with the finger (determinate)
         before it spins. No animation on show/hide: the strip is the state, it does not slide in. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:max="100"
        android:visibility="gone"
        app:hideAnimationBehavior="none"
        app:indicatorColor="@color/ui_primary"
        app:indicatorTrackGapSize="0dp"
        app:showAnimationBehavior="none"
        app:trackColor="@color/ui_hairline"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="@dimen/ui_refresh_strip_height" />

    <!-- §5.16 / §6.8 #2: a failed refresh over readable rows reports here and keeps them. Only a
         zero-row failure takes the empty slot. -->
    <include
        android:id="@+id/errorStrip"
        layout="@layout/include_error_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/ui_gutter" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/space_8"
                android:paddingBottom="@dimen/space_24" />

            <LinearLayout
                android:id="@+id/skeletonRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/ui_skeleton_loading"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8"
                android:visibility="gone">

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />
            </LinearLayout>

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/textEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_pending_actions"
                app:subtitle="@string/ui_admin_requests_empty_pending_body"
                app:title="@string/ui_admin_requests_empty_pending_title" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
