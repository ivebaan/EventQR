<?xml version="1.0" encoding="utf-8"?>
<!-- Strong status pill, error tone (5.4, v1.62 manage rewards): the out-of-stock exception.

     Fill ui_error_container, 1dp ui_error boundary (5.59:1 on its own fill, 6.59:1 on ui_surface),
     ink ui_on_error_container (9.21:1) from the consumer - the loudest element on the card, and the
     same tone pair the Destructive trigger proves on ui_surface (5.1). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ui_error_container" />
    <stroke
        android:width="@dimen/stroke_hairline"
        android:color="@color/ui_error" />
    <corners android:radius="@dimen/ui_radius_badge" />
</shape>
