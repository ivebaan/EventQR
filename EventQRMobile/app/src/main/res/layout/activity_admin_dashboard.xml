<?xml version="1.0" encoding="utf-8"?>
<!--
    ADMIN DASHBOARD (§6.5 of MyFiles/EventQR-Redesign-Plan.md) - retires the menu build.

        Pass head   role tabs, title Admin (Super admin for SUPER_ADMIN),
                    stub PENDING / ACTIVE / ACCOUNTS - all three from GET /admin/stats
        WAITING ON YOU  up to three pending requests (requester, event + submitted, Pending review).
                        View all requests only beyond three; zero renders one No requests waiting row.
        RECENT ACTIVITY up to three read-only audit rows. Supplementary: hidden when the call fails.

    Deleted: OVERVIEW and its two metric rows, MANAGE and its three nav rows (they duplicated the
    bottom nav), the pending alert row, the bottom load hint, the bottom spinner and the pass-head
    skeleton (v1.46). The bottom nav is the only entry point to Requests, Accounts and Logs.

    A dashboard block is never a bare entry point to a bottom-nav destination (§6.5).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- ═════════ Pass head: identity + tear + stub, max three stats ═════════ -->
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!--
        First load: the head stays on screen, exactly as the attendee home does. Its role tabs,
        title and the three labels are known before the request (session + constants) and the
        counts already print their unavailable dash, so a skeleton over it would blank real text and
        redraw the head at a height the loaded one does not use (5.11 exception). Only the queue
        below is placeholder.
    -->

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_32">

                <!-- ═════════ WAITING ON YOU - the primary block ═════════ -->
                <TextView
                    android:id="@+id/textWaitingEyebrow"
                    style="@style/TextAppearance.EventQR.Type.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_24"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:text="@string/ui_admin_eyebrow_waiting" />

                <!-- First load: skeleton rows at the loaded row geometry - 72dp content plus the
                     1dp divider each loaded row draws - so nothing jumps when the queue lands. -->
                <LinearLayout
                    android:id="@+id/skeletonDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:contentDescription="@string/ui_skeleton_loading"
                    android:focusable="true"
                    android:orientation="vertical">

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_skeleton_row_height" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:layout_marginStart="@dimen/ui_divider_inset"
                        android:background="@color/ui_hairline"
                        android:importantForAccessibility="no" />

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_skeleton_row_height" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:layout_marginStart="@dimen/ui_divider_inset"
                        android:background="@color/ui_hairline"
                        android:importantForAccessibility="no" />

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_skeleton_row_height" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:layout_marginStart="@dimen/ui_divider_inset"
                        android:background="@color/ui_hairline"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <!-- Stats failed: in-flow empty state where the queue was, one Retry (§6.8 row 3). -->
                <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                    android:id="@+id/layoutDashboardError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_4"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    app:gutter="false"
                    app:icon="@drawable/ic_ui_warning"
                    app:subtitle="@string/ui_admin_error_body"
                    app:title="@string/ui_admin_dashboard_error"
                    tools:visibility="visible" />

                <!-- The preview rows are inflated at bind time (list_row_icon + ListRowBinder). -->
                <LinearLayout
                    android:id="@+id/pendingRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical" />

                <!-- Loaded, genuinely zero: one 56dp row, no chevron, no click action. -->
                <TextView
                    android:id="@+id/textNoPending"
                    style="@style/Widget.EventQR.Ui.ListRow.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:text="@string/ui_admin_pending_empty"
                    android:textColor="@color/ui_text_primary"
                    android:visibility="gone" />

                <!-- Truncated preview only: extends the queue, never a second nav entry. -->
                <TextView
                    android:id="@+id/btnViewAllRequests"
                    style="@style/Widget.EventQR.Ui.SectionAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_2"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/ui_admin_view_all_requests"
                    android:visibility="gone" />

                <!-- ═════════ RECENT ACTIVITY - read-only, supplementary ═════════ -->
                <LinearLayout
                    android:id="@+id/recentActivityBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextAppearance.EventQR.Type.Eyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_32"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:text="@string/ui_admin_eyebrow_recent" />

                    <LinearLayout
                        android:id="@+id/auditRowsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
