<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive trigger label (§5.1): ui_error, ui_text_disabled when the action is
     unavailable. The outline never carries white text; the one filled red block (the attendee
     Profile's Sign out, v1.52) takes @color/ui_on_primary through DestructiveCommit. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/ui_text_disabled" />
    <item android:color="@color/ui_error" />
</selector>
