<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - ATTENDEES (6.4).

        Pass head        Compact pass head (4.6 / 6.2), title Attendees, no eyebrow, no stat strip
        Event selector   56dp field row (not a card wrapping a hidden spinner)
        Grouped rows     avatar + name + email, one status badge, hairline divider inset 76dp
        Search           44dp icon action that opens the search screen (which owns the filters)

    Deleted: the 44 raw dp literals, per-card attendee blocks, the tinted stat card, the centred
    empty block and the PopupWindow built from a GradientDrawable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Event picker: the shared searchable field (plan 5.2 "Event picker"). -->
    <com.thedavelopers.eventqr.ui.components.EventPickerField
        android:id="@id/event_picker_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/ui_gutter" />

    <!-- Section row: eyebrow + the one search action. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ui_touch_min"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_24"
        android:layout_marginEnd="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtCurrentEventLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_organizer_attendees"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

        <ImageView
            android:id="@+id/btnFilter"
            style="@style/Widget.EventQR.Ui.Button.Icon"
            android:layout_width="@dimen/ui_touch_min"
            android:layout_height="@dimen/ui_touch_min"
            android:contentDescription="@string/ui_organizer_search_attendees"
            android:src="@drawable/ic_ui_search"
            android:tint="@color/ui_text_primary" />
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshAttendeeManagement"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAttendees"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/space_24" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/layoutAttendeesEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_person"
                app:subtitle="@string/attendee_management_attendees_will_appear_here_once_they"
                app:title="@string/attendee_management_no_attendees_registered_yet" />

            <LinearLayout
                android:id="@+id/skeletonLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:visibility="gone"
                android:contentDescription="@string/ui_skeleton_loading"
                android:orientation="vertical">
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
            </LinearLayout>
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/layoutBottomNavHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
