<?xml version="1.0" encoding="utf-8"?>
<!-- 1dp vertical hairline for LinearLayout showDividers: it takes the row's height without asking
     for it, unlike a match_parent View, which grows to the whole screen inside a wrap_content row. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <size android:width="@dimen/stroke_hairline" />
    <solid android:color="@color/ui_hairline" />
</shape>
