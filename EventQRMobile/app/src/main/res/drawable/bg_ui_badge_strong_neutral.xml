<?xml version="1.0" encoding="utf-8"?>
<!-- Strong status pill, neutral tone (5.4, v1.62 manage rewards): the bordered variant that carries
     an EXCEPTION state, so it outranks the quiet dot + word a normal row wears.

     A stroke cannot ride on backgroundTint (a tint recolours the solid AND the boundary), which is
     why this tone is a drawable instead of a tint on bg_ui_badge. Fill ui_surface_sunken,
     1dp ui_outline_interactive boundary (3.01:1 on its own fill, 3.69:1 on ui_surface),
     ink ui_text_primary (15.11:1) from the consumer. Both blocked words share this pill and differ
     only in the label: `Rewards off` (event switch) / `Disabled` (INACTIVE reward), v1.63. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ui_surface_sunken" />
    <stroke
        android:width="@dimen/stroke_hairline"
        android:color="@color/ui_outline_interactive" />
    <corners android:radius="@dimen/ui_radius_badge" />
</shape>
